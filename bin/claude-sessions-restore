#!/usr/bin/env python3
"""Reopen the Claude Code sessions saved by claude-sessions-save.py in Ghostty.

Usage: python3 ~/claude-sessions-restore.py [--file PATH] [--list] [--only N[,N...]]

One Ghostty tab per session (the first goes in a new window), started in the
session's directory and running `claude --resume <id>`. When claude exits the
tab falls back to a login shell. Needs Ghostty 1.3+ (AppleScript support).
"""
import argparse
import json
import os
import subprocess
import sys
import time

HOME = os.path.expanduser("~")

# argv: directory, command, "window" | "tab", title
APPLESCRIPT = """
on run argv
  set theDir to item 1 of argv
  set theCmd to item 2 of argv
  set theMode to item 3 of argv
  set theTitle to item 4 of argv
  tell application "Ghostty"
    set cfg to {initial working directory:theDir, command:theCmd}
    if theMode is "window" then
      set w to new window with configuration cfg
      set t to selected tab of w
    else
      set t to new tab with configuration cfg
    end if
    perform action ("set_tab_title:" & theTitle) on (focused terminal of t)
  end tell
end run
"""


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--file", default=os.path.join(HOME, ".claude-sessions.json"))
    ap.add_argument("--list", action="store_true", help="print the snapshot and exit")
    ap.add_argument("--only", help="comma-separated 1-based indexes to restore")
    args = ap.parse_args()

    snap = json.load(open(args.file))
    sessions = snap["sessions"]
    only = {int(x) for x in args.only.split(",")} if args.only else None

    print("snapshot from %s" % snap.get("savedAt"))
    first = True
    for i, s in enumerate(sessions, 1):
        if only and i not in only:
            continue
        print("%2d. %s\n    %s  %s" % (i, s["title"], s["cwd"], s["sessionId"]))
        if args.list:
            continue
        if not os.path.isdir(s["cwd"]):
            print("    skipped: directory is missing", file=sys.stderr)
            continue
        cmd = "/bin/zsh -lic 'claude --resume %s; exec /bin/zsh -l'" % s["sessionId"]
        r = subprocess.run(
            ["osascript", "-e", APPLESCRIPT, s["cwd"], cmd, "window" if first else "tab", s["title"]],
            capture_output=True, text=True,
        )
        if r.returncode != 0:
            print("    failed: %s" % r.stderr.strip(), file=sys.stderr)
            continue
        first = False
        time.sleep(0.5)
    return 0


if __name__ == "__main__":
    sys.exit(main())
