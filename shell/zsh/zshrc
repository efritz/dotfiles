includes=(
    ~/.zsh/homebrew # must come before $(brew --prefix) calls
    ~/.zsh/aliases
    ~/.zsh/autocorrect
    ~/.zsh/exports
    ~/.zsh/history
    ~/.zsh/hooks
    ~/.zsh/oh-my-zsh
    ~/.zsh/completions
    ~/.zsh/paths
    ~/.zsh/plugins
    ~/.zsh/update_check
    ~/.fzf.zsh
    ~/.zsh/zshrc-`hostname -s`
)

for config in $includes; do
    if [[ -f $config ]]; then
        source $config
    fi
done

