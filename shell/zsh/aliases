# enable aliases to be sudo’ed
alias sudo='sudo '

# safe defaults
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'

# make parent dirs
alias mkdir='mkdir -p'

# map function (e.g. `find . -name .gitattributes | map dirname`)
alias map='xargs -n1'

# go to repo root
alias rr='cd "$(git rev-parse --show-toplevel)"'

# go to outermost repo root (handles nested git repos)
alias rrr='cd "$(r=$(git rev-parse --show-toplevel); while git -C "$r/.." rev-parse --show-toplevel &>/dev/null; do r=$(git -C "$r/.." rev-parse --show-toplevel); done; echo "$r")"'
