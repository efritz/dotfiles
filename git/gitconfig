[user]
	name = Eric Fritz
	email = eric@eric-fritz.com
	signingkey = 08351BC3D28E20D3
[github]
	user = efritz
[url "git@github.com:"]
	insteadOf = git://github.com/
	insteadOf = https://github.com/
[core]
	pager = delta
	excludesfile = /Users/efritz/dev/efritz/dotfiles/git/gitignore_global
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space
	preloadindex = true
	abbrev = 12
	commitGraph = true
[alias]
	wip = !git-wip && :
	squash = !git-squash && :
	pr = !git-pr && :
	yeet = !git-yeet && :
	nuke = !git-nuke && :
	merge-default = !git-merge-default && :
	reset-default = !git-reset-default && :
	prune-branches = !git-prune-branches && :
	sign-commits = "!f() { git rebase --exec \"git commit --amend --no-edit -n -S\" -i \"${1:-$(git merge-base HEAD main)}\"; }; f"
[status]
	showuntrackedfiles = all
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[diff]
	algorithm = histogram
	renames = copies
[trace2]
	eventTarget = af_unix:/Users/efritz/.gittrace/trace.sock
	eventBrief = true
	eventNesting = 1
	configparams = custom.metacommands
[init]
	defaultBranch = main
